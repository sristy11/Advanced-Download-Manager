<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>

<AnchorPane fx:id="anchorPane" prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.adm.PageManager">

   <!-- Main VBox to hold everything -->
   <VBox alignment="TOP_CENTER" prefHeight="600.0" prefWidth="800.0" spacing="20" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10" AnchorPane.topAnchor="10">

      <!-- Title -->
      <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-background-color: #3597e1; -fx-text-fill: white; -fx-padding: 10px;" text="ADVANCED DOWNLOAD MANAGER" />

      <!-- TabPane for download states -->
      <TabPane prefHeight="526.0" prefWidth="829.0">
         <tabs>

            <!-- Tab for Videos -->
            <Tab fx:id="Dtab" closable="false" text="  videos  ">
               <!-- Wrap the VBox inside a ScrollPane to make it scrollable -->
               <ScrollPane fx:id="videoScrollPane" fitToHeight="true" fitToWidth="true">
                  <VBox fx:id="videoVBox" spacing="15" style="-fx-padding: 10px; -fx-background-color: white">
                     <!-- Dynamically added video download items will appear here -->
                  </VBox>
               </ScrollPane>
            </Tab>

            <!-- Tab for Musics -->
            <Tab closable="false" text="  Musics  ">
               <!-- Wrap the VBox inside a ScrollPane to make it scrollable -->
               <ScrollPane fx:id="musicScrollPane" fitToHeight="true" fitToWidth="true">
                  <VBox fx:id="musicVBox" prefHeight="464.0" prefWidth="819.0" spacing="15" style="-fx-padding: 10px; -fx-background-color: white" />
               </ScrollPane>
            </Tab>

            <!-- Tab for Documents -->
            <Tab closable="false" text="  Documents  ">
               <!-- Wrap the VBox inside a ScrollPane to make it scrollable -->
               <ScrollPane fx:id="docScrollPane" fitToHeight="true" fitToWidth="true">
                  <VBox fx:id="docVBox" spacing="15" style="-fx-padding: 10px; -fx-background-color: white">
                     <!-- Dynamically added document download items will appear here -->
                  </VBox>
               </ScrollPane>
            </Tab>

            <!-- Tab for Others (Files tab) -->
            <Tab closable="false" text="  others  ">
               <!-- Wrap the VBox inside a ScrollPane to make it scrollable -->
               <ScrollPane fx:id="otherScrollPane" fitToHeight="true" fitToWidth="true">
                  <VBox fx:id="otherVBox" spacing="15" style="-fx-padding: 10px; -fx-background-color: white">
                     <!-- Dynamically added other file download items will appear here -->
                  </VBox>
               </ScrollPane>
            </Tab>

         </tabs>
      </TabPane>
   </VBox>

   <!-- Bottom navigation buttons -->
   <Pane layoutX="-4.0" layoutY="658.0" prefHeight="146.0" prefWidth="840.0">
      <children>
         <Rectangle arcHeight="5.0" arcWidth="5.0" fill="#dbf8fc" height="116.0" layoutY="22.0" stroke="#00a3cc" strokeType="INSIDE" width="996.0" />
         <ButtonBar layoutX="14.0" layoutY="7.0" prefHeight="40.0" prefWidth="81.0" />
         <Button layoutX="580.0" layoutY="67.0" mnemonicParsing="false" onAction="#handleFiles" prefHeight="26.0" prefWidth="98.0" text="Files" />
         <Button layoutX="74.0" layoutY="67.0" mnemonicParsing="false" onAction="#handleHome" prefHeight="26.0" prefWidth="98.0" text="Home" />
         <Button layoutX="339.0" layoutY="67.0" mnemonicParsing="false" onAction="#handleSettings" prefHeight="26.0" prefWidth="98.0" text="Settings" />
         <!-- Fixed the closing quote for the style attribute -->
         <Button layoutX="819.0" layoutY="67.0" mnemonicParsing="false" onAction="#handleClearAll" prefHeight="26.0" prefWidth="98.0" style="-fx-background-color: #cd6262; -fx-text-fill: #ffffff;" text="Clear all" />
      </children>
   </Pane>

</AnchorPane>
